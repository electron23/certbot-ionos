# certsync configuration: which certificates exist and where they are deployed.
# Copy this file to certsync.env (same folder). It is re-read automatically,
# a change starts a new cycle within ~30 seconds. No container restart needed.
#
# Global settings (ACME_EMAIL, IONOS_*, ...) come from the container environment.
# You may also set them here, values in this file win.
#
# Everyone with access to the share can read this file. Put passwords here only
# if that is acceptable.

# ----------------------------------------------------------- certificates ---
# One entry per certificate. Add a new domain = add a name here + two variables.
# A wildcard does not cover the bare domain, so list both if you need both.
CERTS=srv,smart

CERT_SRV_DOMAINS=*.srv.example.net,srv.example.net
CERT_SRV_TARGETS=proxmox,adguard,udm

CERT_SMART_DOMAINS=*.smart.example.net,smart.example.net
CERT_SMART_TARGETS=homeassistant,ha_apps

# ---------------------------------------------------------------- targets ---
# TARGET_<NAME>_TYPE selects the plugin. All other TARGET_<NAME>_* are options.
# A target can be used by several certificates.

# Proxmox VE (API token needs Sys.Modify on /nodes/<node>)
TARGET_PROXMOX_TYPE=proxmox
TARGET_PROXMOX_URL=https://pve.srv.example.net:8006
TARGET_PROXMOX_NODES=pve
TARGET_PROXMOX_TOKEN=root@pam!certsync=00000000-0000-0000-0000-000000000000
TARGET_PROXMOX_VERIFY_TLS=false

# AdGuard Home
TARGET_ADGUARD_TYPE=adguard
TARGET_ADGUARD_URL=http://192.0.2.35:3000
TARGET_ADGUARD_USERNAME=admin
TARGET_ADGUARD_PASSWORD=change-me

# UniFi OS (UDM Pro), SSH must be enabled on the console
TARGET_UDM_TYPE=unifi
TARGET_UDM_HOST=192.0.2.1
TARGET_UDM_PASSWORD=change-me

# Home Assistant (SSH add-on). Restarts Home Assistant Core to load the cert.
TARGET_HOMEASSISTANT_TYPE=homeassistant
TARGET_HOMEASSISTANT_HOST=192.0.2.50
TARGET_HOMEASSISTANT_PASSWORD=change-me

# Apps (add-ons) that use the same /ssl files. Only the restart command differs.
TARGET_HA_APPS_TYPE=homeassistant
TARGET_HA_APPS_HOST=192.0.2.50
TARGET_HA_APPS_PASSWORD=change-me
TARGET_HA_APPS_COMMAND=ha addons restart core_nginx_proxy

# Any other host reachable via SSH (generic). Use TARGET_<NAME>_KEY_FILE for a key
# placed on the share, e.g. /share/config/id_ed25519 (chmod 600 is not enforced by Samba).
# TARGET_OTHER_TYPE=ssh
# TARGET_OTHER_HOST=192.0.2.60
# TARGET_OTHER_USER=root
# TARGET_OTHER_PASSWORD=change-me
# TARGET_OTHER_FULLCHAIN_PATH=/etc/ssl/certs/srv.pem
# TARGET_OTHER_PRIVKEY_PATH=/etc/ssl/private/srv.key
# TARGET_OTHER_COMMAND=systemctl reload nginx

# Your own script from the share's "scripts" folder (any system, any protocol).
# It gets CERT_FULLCHAIN, CERT_PRIVKEY, ... and OPT_<KEY> as environment.
# TARGET_MYAPP_TYPE=script
# TARGET_MYAPP_PATH=example-deploy.sh
# TARGET_MYAPP_HOST=192.0.2.60
