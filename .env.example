# Variables for the Portainer stack ("Environment variables" section).
# Certificates and targets are configured in config/certsync.env on the share,
# see examples/certsync.env.example.

# ------------------------------------------------------------- required ----
ACME_EMAIL=you@example.com
# IONOS Developer API key: https://developer.hosting.ionos.de/keys  ("<prefix>.<secret>")
IONOS_PREFIX=
IONOS_SECRET=
# Password for the Samba share (\\<docker-host>\certsync)
SMB_PASSWORD=

# ------------------------------------------------------------- optional ----
# true = Let's Encrypt staging, certificates are NOT trusted. Set to false for real use.
ACME_STAGING=true
SMB_USER=certsync
# Seconds to wait for the TXT record before Let's Encrypt validates it.
DNS_PROPAGATION_SECONDS=120
CHECK_INTERVAL_HOURS=12
RENEW_DAYS_BEFORE_EXPIRY=30
# rsa (most compatible) or ecdsa
KEY_TYPE=rsa
LOG_LEVEL=INFO
# User/group used by both containers
PUID=1000
PGID=1000
# Image name/tag the stack builds and uses (or a prebuilt image from your registry)
# CERTSYNC_IMAGE=
# Host port of the share (default 445)
# SMB_PORT=445
# Use a host folder instead of the named volume "certsync-share"
# (must exist and be owned by PUID:PGID), e.g. /srv/certsync
# SHARE_PATH=
